# .env.example — внешние интеграции (в тесте НЕ используются, только контракт)

# Supabase (для полного продукта SGX: Postgres/Auth/Storage/Edge Functions)
VITE_SUPABASE_URL=https://<проект>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-ключ, только публичный>

# AI-ассистент чата записи («хочу мойку завтра после шести»)
LLM_BASE_URL=https://<ваш-LLM-прокси>/v1
LLM_API_KEY=<серверный ключ, не в бандл!>
LLM_MODEL=<модель>

# Web Push (VAPID) — только для установленного PWA
VAPID_PUBLIC_KEY=<публичный>
VAPID_PRIVATE_KEY=<секрет, только сервер>
